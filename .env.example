# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Encryption key for storing GitHub tokens safely
# Generate with: python scripts/generate_key.py
ENCRYPTION_KEY=your_fernet_encryption_key_here

# DeepSeek AI (primary)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# Gemini AI (fallback)
GEMINI_API_KEY=your_gemini_api_key_here
# Pace bulk scans to avoid per-minute Gemini quota bursts
GEMINI_REQUEST_INTERVAL_SECONDS=15

# AI request limits
AI_MAX_DIFF_CHARS=100000
AI_MAX_OUTPUT_TOKENS=2048
AI_CONFLICT_MAX_OUTPUT_TOKENS=8192
AI_CONFLICT_PROVIDER_RETRIES=2

# Automatically repair real Git merge conflicts, then require fresh CI/review
AUTO_RESOLVE_CONFLICTS=true
AUTO_RESOLVE_MAX_ATTEMPTS=2
AUTO_RESOLVE_MAX_FILES=6
AUTO_RESOLVE_MAX_BLOCKS=24
AUTO_RESOLVE_MAX_CONFLICT_CHARS=80000

# Your public server URL (from Railway/Render after deployment)
PUBLIC_URL=https://your-bot.railway.app

# Random secret shared by every webhook this service creates (32+ characters)
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Database
# Local development; use managed PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./bot.db
