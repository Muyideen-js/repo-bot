# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Encryption key for storing GitHub tokens safely
# Generate with: python scripts/generate_key.py
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Your public server URL (from Railway/Render after deployment)
PUBLIC_URL=https://your-bot.railway.app

# GitHub App Webhook Secret (set this when creating your GitHub App)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./bot.db
